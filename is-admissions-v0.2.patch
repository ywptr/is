diff --git a/src/lib/admin-access.ts b/src/lib/admin-access.ts
new file mode 100644
index 0000000..d14152d
--- /dev/null
+++ b/src/lib/admin-access.ts
@@ -0,0 +1,15 @@
+import { auth } from "@/lib/auth";
+import { isISAdministrator } from "@/lib/admission";
+
+export async function currentAdminUserId(headers: Headers): Promise<string | null> {
+  const session = await auth.api.getSession({ headers });
+  if (!session?.user?.id) return null;
+  return (await isISAdministrator(session.user.id)) ? session.user.id : null;
+}
+
+export function hasTrustedOrigin(headers: Headers): boolean {
+  const origin = headers.get("origin");
+  const configured = process.env.BETTER_AUTH_URL;
+  if (!origin || !configured) return false;
+  try { return origin === new URL(configured).origin; } catch { return false; }
+}
diff --git a/src/lib/admission.ts b/src/lib/admission.ts
new file mode 100644
index 0000000..d30f006
--- /dev/null
+++ b/src/lib/admission.ts
@@ -0,0 +1,22 @@
+import { pool } from "@/lib/database";
+
+export function normalizeEmail(value: unknown): string | null {
+  if (typeof value !== "string") return null;
+  const email = value.trim().toLowerCase();
+  // Deliberately no wildcard, domain allow, or substring matching.
+  if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return null;
+  return email;
+}
+
+export async function isEmailPermitted(value: unknown): Promise<boolean> {
+  const email = normalizeEmail(value);
+  if (!email) return false;
+  // Fail closed if PostgreSQL is unavailable. No in-memory allowlist fallback.
+  const result = await pool.query("SELECT 1 FROM is_admission_emails WHERE email = $1", [email]);
+  return (result.rowCount ?? 0) > 0;
+}
+
+export async function isISAdministrator(userId: string): Promise<boolean> {
+  const result = await pool.query("SELECT 1 FROM is_administrators WHERE user_id = $1", [userId]);
+  return (result.rowCount ?? 0) > 0;
+}
