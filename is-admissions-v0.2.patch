diff --git a/scripts/bootstrap-admissions.mjs b/scripts/bootstrap-admissions.mjs
new file mode 100644
index 0000000..ad61a35
--- /dev/null
+++ b/scripts/bootstrap-admissions.mjs
@@ -0,0 +1,30 @@
+/** Run once AFTER IS Better Auth sign-in and app migrations; operator only. */
+import pg from "pg";
+const userId = process.env.IS_BOOTSTRAP_ADMIN_USER_ID?.trim();
+const raw = process.env.IS_ALLOWED_EMAILS || "";
+const emails = [...new Set(raw.split(",").map(v => v.trim().toLowerCase()).filter(Boolean))];
+if (!process.env.DATABASE_URL || !userId || emails.length === 0) {
+  throw new Error("Set DATABASE_URL, IS_BOOTSTRAP_ADMIN_USER_ID, IS_ALLOWED_EMAILS");
+}
+const valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+if (emails.some(email => email.length > 254 || !valid.test(email))) throw new Error("Invalid allowlist email");
+const client = new pg.Client({ connectionString: process.env.DATABASE_URL, connectionTimeoutMillis: 15000 });
+await client.connect();
+try {
+  await client.query("BEGIN");
+  const user = await client.query('SELECT id, email FROM "user" WHERE id = $1', [userId]);
+  if (user.rowCount !== 1) throw new Error("Bootstrap IS user ID does not exist");
+  const operatorEmail = user.rows[0].email.trim().toLowerCase();
+  if (!emails.includes(operatorEmail)) throw new Error("Bootstrap operator email must be in IS_ALLOWED_EMAILS");
+  for (const email of emails) {
+    await client.query(`INSERT INTO is_admission_emails (email, created_by, note)
+      VALUES ($1, $2, 'Imported from IS_ALLOWED_EMAILS') ON CONFLICT (email) DO NOTHING`, [email, userId]);
+  }
+  await client.query(`INSERT INTO is_administrators (user_id, created_by)
+    VALUES ($1, $1) ON CONFLICT (user_id) DO NOTHING`, [userId]);
+  await client.query("COMMIT");
+  console.log(`Bootstrap completed. Imported ${emails.length} emails and authorized operator ${userId}.`);
+} catch (err) {
+  await client.query("ROLLBACK");
+  throw err;
+} finally { await client.end(); }
diff --git a/scripts/migrate-app.mjs b/scripts/migrate-app.mjs
new file mode 100644
index 0000000..9fc2271
--- /dev/null
+++ b/scripts/migrate-app.mjs
@@ -0,0 +1,49 @@
+/** Explicit, linear migration runner for IS-owned tables; does not touch Better Auth migrations. */
+import pg from "pg";
+import { readFile, readdir } from "node:fs/promises";
+import { createHash } from "node:crypto";
+import { fileURLToPath } from "node:url";
+import { dirname, join } from "node:path";
+
+if (!process.env.DATABASE_URL) throw new Error("DATABASE_URL missing");
+const folder = join(dirname(fileURLToPath(import.meta.url)), "../db/migrations");
+const client = new pg.Client({ connectionString: process.env.DATABASE_URL, connectionTimeoutMillis: 15000 });
+await client.connect();
+try {
+  await client.query("SELECT pg_advisory_lock(83792421)");
+  await client.query(`CREATE TABLE IF NOT EXISTS is_schema_migrations (
+    name text PRIMARY KEY, sha256 text NOT NULL, applied_at timestamptz NOT NULL DEFAULT now()
+  )`);
+  const migrations = (await readdir(folder)).filter(f => /^\d{4}_[a-z0-9_]+\.sql$/.test(f)).sort();
+  const appliedResult = await client.query("SELECT name, sha256 FROM is_schema_migrations");
+  const applied = new Map(appliedResult.rows.map(row => [row.name, row.sha256]));
+  for (const name of applied.keys()) {
+    if (!migrations.includes(name)) throw new Error(`Applied migration is missing from source: ${name}`);
+  }
+  // Refuse to apply a new revision if an earlier revision is not the applied prefix.
+  let seenPending = false;
+  for (const name of migrations) {
+    const sql = await readFile(join(folder, name), "utf8");
+    const checksum = createHash("sha256").update(sql).digest("hex");
+    if (applied.has(name)) {
+      if (seenPending) throw new Error(`Out-of-order applied migration: ${name}`);
+      if (applied.get(name) !== checksum) throw new Error(`Migration changed after application: ${name}`);
+      console.log(`Applied: ${name}`);
+      continue;
+    }
+    seenPending = true;
+    await client.query("BEGIN");
+    try {
+      await client.query(sql);
+      await client.query("INSERT INTO is_schema_migrations (name, sha256) VALUES ($1, $2)", [name, checksum]);
+      await client.query("COMMIT");
+      console.log(`Migrated: ${name}`);
+    } catch (err) {
+      await client.query("ROLLBACK");
+      throw err;
+    }
+  }
+  console.log("IS application migrations complete");
+} finally {
+  try { await client.query("SELECT pg_advisory_unlock(83792421)"); } finally { await client.end(); }
+}
diff --git a/src/app/admin/admissions/manager.tsx b/src/app/admin/admissions/manager.tsx
new file mode 100644
index 0000000..4c83640
