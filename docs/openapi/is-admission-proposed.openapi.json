    "/api/is/v1/admission/redemptions": {
      "post": {
        "operationId": "redeemAdmission",
        "description": "Proposed client assertion + PKCE + token-endpoint-style DPoP; no cookie/Bearer fallback, no public CORS. Max 32 KiB. Atomic one-use redemption, current eligibility and durable audit. Profile support requires implementation review.",
        "security": [
          {
            "DPoPProof": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Redemption"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "No-store signed admission receipt; never a resource API access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdmissionReceipt"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              },
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
