  "components": {
    "securitySchemes": {
      "ISSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "IS_SESSION_PLACEHOLDER",
        "description": "Existing secure IS session; exact provider cookie configured at implementation. Mutations also require strict Origin and CSRF."
      },
      "DPoPProof": {
        "type": "apiKey",
        "in": "header",
        "name": "DPoP",
        "description": "Maintained DPoP proof validation; redemption binds sender key, no ath."
      }
    },
    "schemas": {
      "Selection": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "tenantId",
          "expectedVersion"
        ]
      },
      "Choices": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transactionId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "tenants": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tenantId": {
                  "type": "string",
                  "format": "uuid"
                },
                "displayName": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "required": [
                "tenantId",
                "displayName"
              ]
            }
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          }
        },
        "required": [
          "transactionId",
          "version",
          "applicationId",
          "expiresAt",
          "tenants",
          "cursor"
        ]
      },
      "Redemption": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "client_assertion_type": {
            "const": "urn:ietf:params:oauth:client-assertion-type:jwt-bearer"
          },
          "client_assertion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "code": {
            "type": "string",
            "minLength": 32,
            "maxLength": 512
          },
          "code_verifier": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._~-]{43,128}$"
          },
          "redirect_uri": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          }
        },
        "required": [
          "client_id",
          "client_assertion_type",
          "client_assertion",
          "code",
          "code_verifier",
          "redirect_uri"
        ]
      },
      "AdmissionReceipt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "admission_context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          },
          "expires_in": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "profile": {
            "const": "is-admission-1"
          }
        },
        "required": [
          "admission_context",
          "expires_in",
          "profile"
        ]
      },
      "AdmissionClaims": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "iss": {
            "type": "string",
            "format": "uri"
          },
          "sub": {
            "type": "string",
            "minLength": 1
          },
          "aud": {
            "type": "string",
            "minLength": 1
          },
          "iat": {
            "type": "integer"
          },
          "exp": {
            "type": "integer"
          },
          "jti": {
            "type": "string",
            "minLength": 1
          },
          "nonce": {
            "type": "string",
            "minLength": 32
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "application_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_id": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "enum": [
              "development",
              "staging",
              "production"
            ]
          },
          "admission_id": {
            "type": "string",
            "format": "uuid"
          },
          "auth_time": {
            "type": "integer"
          },
          "cnf": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "jkt": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{43}$"
              }
            },
            "required": [
              "jkt"
            ]
          },
          "generation": {
            "type": "string",
            "pattern": "^[0-9]+$"
          }
        },
        "required": [
          "iss",
          "sub",
          "aud",
          "iat",
          "exp",
          "jti",
          "nonce",
          "tenant_id",
          "application_id",
          "client_id",
          "environment",
          "admission_id",
          "auth_time",
          "cnf",
          "generation"
        ],
        "description": "Decoded signed payload profile only, typ=is-admission+jwt. Validate using pinned maintained JOSE implementation. aud equals target client_id. TTL <=300s bounded by session/authorization. Not a Nexus credential or local permission."
      }
    }
  },
  "x-internal-capabilities": [
    "Nexus.listEligibleContexts",
    "Nexus.getSelfMembership",
    "Nexus.getEffectiveEntitlement",
    "Nexus.resolveGovernedDomain"
  ],
  "x-transition": "Existing four live Consumer APIs and their schemas remain supported unchanged. No deprecation date. Admission-aware revocation linkage requires explicit new credential profile; no v1 request-field additions."
}
