{
  "name": "is-identity-service",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 5180 --experimental-https --experimental-https-key /home/user/certs/is/dev-key.pem --experimental-https-cert /home/user/certs/is/dev-cert.pem",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:migrate": "npx auth@1.7.10 migrate --yes",
    "db:check": "npx auth@1.7.10 check schema",
    "client:register": "tsx scripts/register-client.ts",
    "db:app:migrate": "node scripts/migrate-app.mjs",
    "admission:bootstrap": "node scripts/bootstrap-admissions.mjs",
    "nexus:bootstrap-operator": "node scripts/bootstrap-nexus-operator.mjs",
    "test:identity:compat": "node --test tests/protocol/identity-compatibility.test.mjs",
    "test:memberships:pg": "node --experimental-strip-types --test tests/integration/nexus-memberships.test.mjs",
    "test:identity:lifecycle": "node --experimental-strip-types --test tests/protocol/identity-lifecycle.test.mjs",
    "test:consumer:pg": "IS_CONSUMER_RUNTIME_TESTS=1 node --experimental-strip-types --test tests/protocol/identity-lifecycle.test.mjs",
    "test:identity:administration": "IS_IDENTITY_ADMIN_TESTS=1 IS_CONSUMER_RUNTIME_TESTS=1 node --experimental-strip-types --test tests/protocol/identity-lifecycle.test.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "better-auth": "1.7.10",
    "next": "16.4.2",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
