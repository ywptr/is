{
  "name": "is-identity-service",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:migrate": "npx auth@1.7.10 migrate --yes",
    "db:check": "npx auth@1.7.10 check schema",
    "client:register": "tsx scripts/register-client.ts",
    "db:app:migrate": "node scripts/migrate-app.mjs",
    "admission:bootstrap": "node scripts/bootstrap-admissions.mjs",
    "nexus:bootstrap-operator": "node scripts/bootstrap-nexus-operator.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "better-auth": "1.7.10",
    "next": "16.4.2",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
