# Canonical issuer host. Use a fixed HTTPS hostname for production.
BETTER_AUTH_URL=http://localhost:5180
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Native dev: postgres://is_dev:<URL-encoded-password>@127.0.0.1:5432/is_dev
# Production: dedicated Neon database with verified TLS. Never copy production credentials locally.
DATABASE_URL=
# PostgreSQL TLS mode. Leave unset in production; IS defaults to verify-full.
# Local development against trusted host PostgreSQL may use:
# IS_DATABASE_SSLMODE=disable
IS_DATABASE_SSLMODE=
# Google OAuth client created for IS. Authorized redirect: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admission bootstrap input only; runtime admission uses is_admission_emails.
IS_ALLOWED_EMAILS=developer@example.com

# Only for the one-off CLI client provisioning command. Never exposed to the browser.
IS_CLIENT_NAME=
IS_CLIENT_REDIRECT_URI=
IS_CLIENT_SECRET_FILE=

# Optional exact native Next HTTPS bind-origin alias. Only for a direct TLS listener,
# with no HTTP/proxy ingress. Host must equal the configured public resource host.
# Leave unset when Request.url already has the canonical public origin.
# NEXUS_CONSUMER_DIRECT_HTTPS_ORIGIN=https://0.0.0.0:5180
