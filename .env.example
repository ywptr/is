# Canonical issuer host. Use a fixed HTTPS hostname for production.
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Neon pooled PostgreSQL connection string. IS gets its OWN database.
DATABASE_URL=
# Google OAuth client created for IS. Authorized redirect: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# MVP allowlist: verified Google emails only, comma separated. Empty => deny ALL.
IS_ALLOWED_EMAILS=developer@example.com

# Only for the one-off CLI client provisioning command. Never exposed to the browser.
IS_CLIENT_NAME=
IS_CLIENT_REDIRECT_URI=
IS_CLIENT_SECRET_FILE=
